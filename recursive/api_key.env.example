OPENAI=xxxx

CLAUDE=xxx

SERPAPI=xxx

GEMINI=xxx

OPENROUTER=xxx

# Minimax M2 API key for Minimax models (e.g., abab6.5s-chat, abab6.5g-chat, abab6.5t-chat)
MINIMAX_API_KEY=your_minimax_api_key_here

# Minimax API base URL (optional, defaults to https://api.minimax.chat/v1)
# MINIMAX_API_BASE=https://api.minimax.chat/v1

# Jina.ai API key for Jina Search and Reader APIs
JINA_API_KEY=your_jina_api_key_here

# Search provider: jina, serpapi, or searxng (default: serpapi)
SEARCH_PROVIDER=serpapi